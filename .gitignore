# 🙈 Git ignore для торгового бота

# Конфиденциальные файлы
.env
*.key
*.secret

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Тестирование
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

# Среды разработки
.env
.venv
env/
venv/
ENV/
out/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Логи и данные
logs/
*.log
data/
*.db

# Системные файлы
.DS_Store
Thumbs.db

# Временные файлы
*.tmp
*.backup
diagnostic_report.json
# Cleanup backups
backup_cleanup_*/
# Legacy files (if any remain)
*_legacy.py
*_old.py
# Application specific
src/application/services/*.pyc
# Analytics exports
analytics_export_*
# Temporary migration files
migration_temp_*


Archive.zip
